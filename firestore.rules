rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin access requires both the server-assigned role claim and a verified email.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.admin == true
        && request.auth.token.email_verified == true;
    }

    function accountCanRead() {
      return request.auth == null ||
        (request.auth.token.email_verified == true &&
          (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'suspended'));
    }

    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'status', 'createdAt', 'lastSeenAt'
        ])
        && request.resource.data.status == 'active'
        && request.resource.data.email == request.auth.token.email;
      allow update: if (
          request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['email', 'displayName', 'lastSeenAt'])
          && request.resource.data.email == request.auth.token.email
        ) || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['active', 'suspended']
        );
      allow delete: if false;
    }

    // A member can manage only their own saved dramas and playback history.
    match /users/{userId}/favorites/{dramaId} {
      allow read: if request.auth != null && request.auth.uid == userId
        && request.auth.token.email_verified == true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['dramaId', 'createdAt'])
        && request.resource.data.dramaId == dramaId;
      allow delete: if request.auth != null && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    match /users/{userId}/watch_history/{episodeId} {
      allow read: if request.auth != null && request.auth.uid == userId
        && request.auth.token.email_verified == true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly([
          'dramaId', 'episodeId', 'dramaTitle', 'episodeTitle',
          'lastPositionSeconds', 'updatedAt'
        ])
        && request.resource.data.episodeId == episodeId
        && request.resource.data.lastPositionSeconds is number
        && request.resource.data.lastPositionSeconds >= 0;
      allow delete: if request.auth != null && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    // View events are written by the trusted callable backend, not directly by clients.
    match /view_events/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Backend-only rate-limit state. Clients have no direct access.
    match /view_rate_limits/{limitId} {
      allow read, write: if false;
    }

    // Append-only audit trail for privileged admin actions.
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      // Only Admin SDK callables may append audit records.
      allow create, update, delete: if false;
    }

    match /dramas/{dramaId} {
      allow read: if isAdmin() || (accountCanRead() && resource.data.status == 'published');
      allow create, update, delete: if isAdmin();

      match /episodes/{episodeId} {
        function parentIsPublished() {
          return get(/databases/$(database)/documents/dramas/$(dramaId)).data.status == 'published';
        }
        allow read: if isAdmin() || (accountCanRead() && parentIsPublished() && resource.data.status == 'published');
        allow create, update, delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
