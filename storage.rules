rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only authenticated platform admins may upload source videos.
    match /uploads/{uid}/{dramaId}/{episodeId}/{fileName} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.get('admin', false) == true
        && request.auth.token.get('email_verified', false) == true
        && request.resource.size < 1073741824
        && request.resource.contentType.matches('video/(mp4|quicktime|x-m4v|x-matroska|webm)');
      allow read, update, delete: if false;
    }

    // Published HLS assets are public media. Only the trusted backend writes them.
    match /hls/{dramaId}/{episodeId}/{fileName} {
      // HLS is delivered through unguessable Firebase download tokens stored in episode documents.
      // Deny unauthenticated SDK/list access to the bucket path itself.
      allow read: if false;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
